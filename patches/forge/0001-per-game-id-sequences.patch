diff --git a/forge-game/src/main/java/forge/game/GameIds.java b/forge-game/src/main/java/forge/game/GameIds.java
new file mode 100644
index 00000000..2eb454b6
--- /dev/null
+++ b/forge-game/src/main/java/forge/game/GameIds.java
@@ -0,0 +1,65 @@
+package forge.game;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Id sequences for game objects that used to come from unsynchronized static counters
+ * ({@code private static int maxId; ++maxId}).
+ *
+ * <p>Those counters are shared by every game in the JVM. When several games run at once (headless
+ * simulation), an unsynchronized {@code ++} can lose updates and hand two objects in the same game
+ * the same id; SpellAbility, Trigger, ReplacementEffect and StaticAbility use that id for
+ * equals/hashCode, so the game then treats different abilities as equal. Sharing the counter also
+ * makes one game's ids (and with them hash ordering and AI tie-breaks) depend on what other games
+ * are doing, so seeded games cannot be reproduced.
+ *
+ * <p>By default every thread uses one global, atomic sequence, which keeps the old behaviour minus
+ * the race. A caller that runs a game on its own thread can call {@link #beginScope()} first: the
+ * game then gets private sequences, inherited by threads it starts (AI evaluation threads). Scoped
+ * ids start at {@link #SCOPED_BASE} so they never collide with ids handed out globally, for
+ * example while card data was being loaded. Game ids themselves are never scoped.
+ */
+public final class GameIds {
+    public enum Kind { GAME, SPELL_ABILITY, STACK_INSTANCE, TRIGGER, REPLACEMENT_EFFECT, STATIC_ABILITY, COMBAT_VIEW }
+
+    public static final int SCOPED_BASE = 1 << 30;
+
+    private static final class Scope {
+        final AtomicInteger[] counters = new AtomicInteger[Kind.values().length];
+        Scope(int start) {
+            for (int i = 0; i < counters.length; i++) {
+                counters[i] = new AtomicInteger(start);
+            }
+        }
+    }
+
+    private static final Scope GLOBAL = new Scope(0);
+    private static final InheritableThreadLocal<Scope> CURRENT = new InheritableThreadLocal<>();
+
+    private GameIds() {}
+
+    public static int next(Kind kind) {
+        // Game ids stay globally unique even inside a scope: static registries such as
+        // AITimeoutTracker are keyed by game id and must tell concurrent games apart.
+        Scope s = kind == Kind.GAME ? null : CURRENT.get();
+        return (s != null ? s : GLOBAL).counters[kind.ordinal()].incrementAndGet();
+    }
+
+    /**
+     * Restart a sequence at {@code value} (offset by {@link #SCOPED_BASE} inside a scope). Only the
+     * calling thread's scope is affected, so one game starting no longer resets another's ids.
+     */
+    public static void reset(Kind kind, int value) {
+        Scope s = CURRENT.get();
+        (s != null ? s : GLOBAL).counters[kind.ordinal()].set(s != null ? SCOPED_BASE + value : value);
+    }
+
+    /** Give games created on this thread (and threads it starts from now on) their own id sequences. */
+    public static void beginScope() {
+        CURRENT.set(new Scope(SCOPED_BASE));
+    }
+
+    public static void endScope() {
+        CURRENT.remove();
+    }
+}
